
# ==============================================================
# Simulation Units
# ==============================================================

units           lj

# ==============================================================
# Atom Style
# ==============================================================

atom_style      bond
# ==============================================================
# Non-Bonded Interactions
# ==============================================================

pair_style      lj/cut 2.5
# ==============================================================
# Bonded Interactions
# ==============================================================

bond_style      harmonic

# ==============================================================
# Read Minimized Structure
# ==============================================================

read_data       ../data/minimized_polymer_melt.data
Reading data file ...
  orthogonal box = (0 0 0) to (60 60 60)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  500 atoms
  reading velocities ...
  500 velocities
  scanning bonds ...
  1 = max bonds/atom
  orthogonal box = (0 0 0) to (60 60 60)
  1 by 1 by 1 MPI processor grid
  reading bonds ...
  475 bonds
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     2 = max # of 1-3 neighbors
     4 = max # of 1-4 neighbors
     6 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.009 seconds

pair_coeff      1 1 1.0 1.0 2.5
bond_coeff      1 100.0 1.0


# ==============================================================
# Neighbor List
# ==============================================================

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# ==============================================================
# Special Bond Interactions
# ==============================================================

special_bonds   lj 0.0 1.0 1.0
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        1        1       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     2 = max # of 1-3 neighbors
     4 = max # of 1-4 neighbors
     6 = max # of special neighbors
  special bonds CPU = 0.000 seconds

# ==============================================================
# Thermodynamic Output
# ==============================================================

thermo          100
thermo_style    custom step temp pe ke etotal press density
thermo_modify   flush yes

# ==============================================================
# Initial Velocities
# ==============================================================

velocity        all create 1.0 12345 mom yes rot yes dist gaussian

# ==============================================================
# Time Integration
# ==============================================================

timestep        0.005

# ==============================================================
# NVT Thermostat
# ==============================================================

fix             1 all nvt temp 1.0 1.0 1.0

# ==============================================================
# Dump Trajectory
# ==============================================================

dump            1 all custom 1000 ../outputs/dumps/nvt.lammpstrj id type x y z

# ==============================================================
# Run Molecular Dynamics
# ==============================================================

run             50000
