  special bonds CPU = 0.000 seconds

# ----------------------------------------------------------
# Neighbor List
# ----------------------------------------------------------

neighbor        0.4 bin
comm_modify cutoff 2.0
neigh_modify    every 1 delay 0 check yes

# ----------------------------------------------------------
# Output
# ----------------------------------------------------------

thermo          100

dump            1 all custom 100 ../outputs/dumps/saw.lammpstrj id mol type x y z

# ----------------------------------------------------------
# Energy Minimization
# ----------------------------------------------------------

min_style       cg

minimize        1.0e-6 1.0e-8 1000 10000
